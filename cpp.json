	"toll_sinsu": {
		"prefix": "to10",
		"body": [
			"ll toll_sinsu(string s, ll n) {",
			"\tll res = 0;",
			"\tfor (char c : s) {",
			"\t\tres = res * n + (c - '0');",
			"\t}",
			"\treturn res;",
			"}"
		],
		"description": "n進数の文字列を10進数(ll)に変換"
	},
	"ton_sinsu": {
		"prefix": "ton",
		"body": [
			"string ton_sinsu(ll n, ll m) {",
			"\tif (n == 0) return \"0\";",
			"\tstring res = \"\";",
			"\twhile (n > 0) {",
			"\t\tres += to_string(n % m);",
			"\t\tn /= m;",
			"\t}",
			"\treverse(res.begin(), res.end());",
			"\treturn res;",
			"}"
		],
		"description": "10進数をm進数の文字列に変換"
	},
	"nCr": {
		"prefix": "ncr",
		"body": [
			"ll nCr(ll n, ll r) {",
			"\tif (r < 0 || r > n) return 0;",
			"\tif (r > n / 2) r = n - r;",
			"\t__int128_t res = 1;",
			"\tfor (ll i = 1; i <= r; i++) {",
			"\t\tres = res * (n - i + 1) / i;",
			"\t}",
			"\treturn (ll)res;",
			"}"
		],
		"description": "combination"
	},
